   "source": [
    "import numpy as np\n",
    "\n",
    "name = ['alice', 'bob', 'cathy', 'doug']\n",
    "age = [25, 45, 37, 19]\n",
    "weight = [55.0, 85.5, 68.0, 61.5]\n",
    "\n",
    "data = np.zeros(\n",
    "    4,\n",
    "    dtype={\n",
    "        'names': ('name', 'age', 'weight'),\n",
    "        'formats': ('U10', 'i4', 'f8')\n",
    "    }\n",
    ")\n",
    "\n",
    "print(\"Structured array using a compound data type\")\n",
    "print(data.dtype)\n",
    "\n",
    "data['name'] = name\n",
    "data['age'] = age\n",
    "data['weight'] = weight\n",
    "\n",
    "print(\"Filled structured array\")\n",
    "print(data)\n",
    "\n",
    "print(\"All names\")\n",
    "print(data['name'])\n",
    "\n",
    "print(\"First row of data\")\n",
    "print(data[0])\n",
    "\n",
    "print(\"Name from last row\")\n",
    "print(data[-1]['name'])\n",
    "\n",
    "print(\"Names where age is under 30\")\n",
    "print(data[data['age'] < 30]['name'])\n",
    "\n",
    "\n",
    "# Different ways to create a structured data type\n",
    "\n",
    "print(np.dtype({\n",
    "    'names': ('name', 'age', 'weight'),\n",
    "    'formats': ('U10', 'i4', 'f8')\n",
    "}))\n",
    "\n",
    "print(np.dtype({\n",
    "    'names': ('name', 'age', 'weight'),\n",
    "    'formats': ((np.str_, 10), int, np.float32)\n",
    "}))\n",
    "\n",
    "print(np.dtype([\n",
    "    ('name', 'S10'),\n",
    "    ('age', 'i4'),\n",
    "    ('weight', 'f8')\n",
    "]))\n",
    "\n",
    "print(np.dtype('S10,i4,f8'))\n",
    "\n",
    "\n",
    "# Structured array with a 3x3 matrix\n",
    "tp = np.dtype([\n",
    "    ('id', 'i8'),\n",
    "    ('mat', 'f8', (3, 3))\n",
    "])\n",
    "\n",
    "x = np.zeros(1, dtype=tp)\n",
    "\n",
    "print(x[0])\n",
    "print(x['mat'][0])"
   ]
